# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.

# The username for the single login account.
APP_USERNAME=admin

# Base64-encoded bcrypt hash of your password (NOT the password itself).
# Generate it with:  npm run hash-password "your-password-here"
APP_PASSWORD_HASH_B64=

# Secret key used to encrypt the session cookie. Use 32+ random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: override where the SQLite database file is stored.
# Defaults to ./data if unset.
# DATA_DIR=./data
